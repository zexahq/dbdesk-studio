{
  "name": "dbdesk-studio",
  "version": "0.1.5",
  "description": "Database management studio with a web interface",
  "bin": {
    "dbdesk-studio": "./packages/cli/dist/cli.js"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "packages/cli/dist",
    "apps/server/dist",
    "apps/web/dist"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo check-types",
    "test": "pnpm --filter server exec tsx --tsconfig ../../apps/web/tsconfig.json --test ../../test/*.ts",
    "test:package": "node test/package-smoke.mjs",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "start": "node packages/cli/dist/cli.js",
    "publish:prepare": "pnpm build && chmod +x packages/cli/dist/cli.js"
  },
  "keywords": [
    "database",
    "studio",
    "web-ui",
    "sql",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zexahq/dbdesk-studio.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@dbdesk-studio/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.13",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.13.1"
}
